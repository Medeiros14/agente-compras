# Copie para .env e preencha a chave. O .env não vai para o git.

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
LLM_TIMEOUT=30

# --- Agente ---
AGENTE_MAX_ITERACOES=8
MCP_TIMEOUT=20

# --- DummyJSON ---
DUMMYJSON_URL=https://dummyjson.com
DUMMYJSON_TIMEOUT=5

# --- Postgres ---
POSTGRES_USER=compras
POSTGRES_PASSWORD=compras
POSTGRES_DB=compras
